diff --git a/spec/models/form/admin_settings_trends_spec.rb b/spec/models/form/admin_settings_trends_spec.rb
new file mode 100644
--- /dev/null
+++ b/spec/models/form/admin_settings_trends_spec.rb
@@ -0,0 +1,29 @@
+# frozen_string_literal: true
+
+require 'rails_helper'
+
+RSpec.describe Form::AdminSettings do
+  describe 'trend settings' do
+    it { is_expected.to allow_value('1').for(:trends_statuses_threshold) }
+    it { is_expected.to_not allow_value('0').for(:trends_statuses_threshold) }
+    it { is_expected.to allow_value('168').for(:trends_statuses_score_halflife_hours) }
+    it { is_expected.to_not allow_value('169').for(:trends_statuses_score_halflife_hours) }
+    it { is_expected.to allow_value('100').for(:trends_tags_threshold) }
+    it { is_expected.to_not allow_value('101').for(:trends_links_threshold) }
+
+    it 'saves values as integers' do
+      form = described_class.new(
+        trends_statuses_threshold: '2',
+        trends_statuses_score_halflife_hours: '3',
+        trends_tags_threshold: '2',
+        trends_links_threshold: '2'
+      )
+
+      expect { form.save }
+        .to change(Setting, :trends_statuses_threshold).from(5).to(2)
+        .and change(Setting, :trends_statuses_score_halflife_hours).from(1).to(3)
+        .and change(Setting, :trends_tags_threshold).from(5).to(2)
+        .and change(Setting, :trends_links_threshold).from(5).to(2)
+    end
+  end
+end
diff --git a/spec/system/admin/settings/discovery_trends_spec.rb b/spec/system/admin/settings/discovery_trends_spec.rb
new file mode 100644
--- /dev/null
+++ b/spec/system/admin/settings/discovery_trends_spec.rb
@@ -0,0 +1,39 @@
+# frozen_string_literal: true
+
+require 'rails_helper'
+
+RSpec.describe 'Admin trend settings' do
+  let(:admin_user) { Fabricate(:admin_user) }
+
+  before { sign_in(admin_user) }
+
+  it 'renders and saves the configurable trend fields' do
+    visit admin_settings_discovery_path
+
+    expect(page)
+      .to have_field(form_label('form_admin_settings.trends_statuses_threshold'), with: '5')
+    expect(page)
+      .to have_field(form_label('form_admin_settings.trends_statuses_score_halflife_hours'), with: '1')
+    expect(page)
+      .to have_field(form_label('form_admin_settings.trends_tags_threshold'), with: '5')
+    expect(page)
+      .to have_field(form_label('form_admin_settings.trends_links_threshold'), with: '5')
+
+    fill_in form_label('form_admin_settings.trends_statuses_threshold'), with: '2'
+    fill_in form_label('form_admin_settings.trends_statuses_score_halflife_hours'), with: '3'
+    fill_in form_label('form_admin_settings.trends_tags_threshold'), with: '2'
+    fill_in form_label('form_admin_settings.trends_links_threshold'), with: '2'
+
+    click_on submit_button
+
+    expect(page)
+      .to have_content(success_message)
+    expect(Setting)
+      .to have_attributes(
+        trends_statuses_threshold: 2,
+        trends_statuses_score_halflife_hours: 3,
+        trends_tags_threshold: 2,
+        trends_links_threshold: 2
+      )
+  end
+end
diff --git a/spec/models/trends/configurable_settings_spec.rb b/spec/models/trends/configurable_settings_spec.rb
new file mode 100644
--- /dev/null
+++ b/spec/models/trends/configurable_settings_spec.rb
@@ -0,0 +1,61 @@
+# frozen_string_literal: true
+
+require 'rails_helper'
+
+RSpec.describe 'Configurable trend settings' do
+  describe Trends::Statuses do
+    subject(:trends) { described_class.new }
+
+    it 'reads current settings without recreating the trends object' do
+      allow(Setting).to receive_messages(
+        trends_statuses_threshold: 2,
+        trends_statuses_score_halflife_hours: 3
+      )
+
+      expect(trends.send(:effective_threshold)).to eq(2)
+      expect(trends.send(:effective_score_halflife)).to eq(3.hours)
+    end
+
+    it 'preserves explicitly supplied options' do
+      trends = described_class.new(threshold: 7, score_halflife: 8.hours)
+
+      allow(Setting).to receive_messages(
+        trends_statuses_threshold: 2,
+        trends_statuses_score_halflife_hours: 3
+      )
+
+      expect(trends.send(:effective_threshold)).to eq(7)
+      expect(trends.send(:effective_score_halflife)).to eq(8.hours)
+    end
+
+    it 'falls back to upstream options for invalid settings' do
+      allow(Setting).to receive_messages(
+        trends_statuses_threshold: 'invalid',
+        trends_statuses_score_halflife_hours: nil
+      )
+
+      expect(trends.send(:effective_threshold)).to eq(5)
+      expect(trends.send(:effective_score_halflife)).to eq(1.hour)
+    end
+  end
+
+  describe Trends::Tags do
+    subject(:trends) { described_class.new }
+
+    it 'reads the current threshold setting' do
+      allow(Setting).to receive(:trends_tags_threshold).and_return(2)
+
+      expect(trends.send(:effective_threshold)).to eq(2)
+    end
+  end
+
+  describe Trends::Links do
+    subject(:trends) { described_class.new }
+
+    it 'reads the current threshold setting' do
+      allow(Setting).to receive(:trends_links_threshold).and_return(2)
+
+      expect(trends.send(:effective_threshold)).to eq(2)
+    end
+  end
+end
